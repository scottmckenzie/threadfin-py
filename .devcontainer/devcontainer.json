{
  "name": "threadfin-py",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "uv sync --locked",
  "forwardPorts": [34400],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  }
}